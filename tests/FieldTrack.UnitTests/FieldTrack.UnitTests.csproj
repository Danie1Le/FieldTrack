<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FieldTrack.Domain\FieldTrack.Domain.csproj" />
    <ProjectReference Include="..\..\src\FieldTrack.Simulator\FieldTrack.Simulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- DomainDependencyTests reads Domain's project file to catch references before code uses them. -->
  <ItemGroup>
    <None Include="..\..\src\FieldTrack.Domain\FieldTrack.Domain.csproj" Link="FieldTrack.Domain.csproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The integration tests own TestImages; compiling the same file here lets a fast test check it against docker-compose. -->
  <ItemGroup>
    <Compile Include="..\FieldTrack.IntegrationTests\TestImages.cs" Link="TestImages.cs" />
    <None Include="..\..\docker-compose.yml" Link="docker-compose.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- FleetFileTests and GpxRouteTests check that the committed fleet file loads and every route in it can be followed. -->
  <ItemGroup>
    <None Include="..\..\src\FieldTrack.Simulator\fleets\**" LinkBase="fleets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TelemetryPayloadTests checks the broker's payload limit matches the contract's. -->
  <ItemGroup>
    <None Include="..\..\docker\mosquitto\mosquitto.conf" Link="mosquitto.conf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
