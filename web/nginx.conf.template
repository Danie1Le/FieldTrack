# Serves the dashboard and proxies /api/ to the API, so the browser talks to one origin (no CORS).

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# The path without the query string: SignalR sends the access token as ?access_token= (#23: no tokens in logs).
log_format no_query '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    root /usr/share/nginx/html;
    access_log /var/log/nginx/access.log no_query;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # Map tiles come from OpenStreetMap; everything else is this origin. Angular and Leaflet set inline styles.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # The container's own DNS servers (Docker's in compose, the environment's in Container Apps), asked again every
    # 10 s: a recreated api container can come back on a new IP. The nginx image fills both ${...} from the environment
    # at start (web/Dockerfile sets the defaults). proxy_pass with a variable resolves per request, so /api is stripped
    # with rewrite instead. nginx's resolver ignores search domains: FIELDTRACK_API_URL needs a name DNS answers as is.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api ${FIELDTRACK_API_URL};
    # proxy_pass with a variable sends any path in it as the whole request URI, so keep only scheme://host[:port].
    if ($api ~ ^(?<api_origin>[^/]+//[^/]+)) {
        set $api $api_origin;
    }

    # The client's address, for the API's per-client sign-in rate limit (#169). Container Apps ingress appends the
    # address it accepted the connection from to X-Forwarded-For, so take only that last entry, and only from a private
    # address (ingress, or Docker's gateway in compose): anything before it is the client's own claim. The API gets this
    # one address, not the chain, so a client cannot add entries the API would believe.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 100.64.0.0/10;
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from fc00::/7;
    set_real_ip_from ::1;
    real_ip_header X-Forwarded-For;
    proxy_set_header X-Forwarded-For $remote_addr;

    proxy_http_version 1.1;
    # The API's own host name, not the dashboard's: Container Apps routes internal requests on it (#156).
    proxy_set_header Host $proxy_host;
    # Container Apps serves the API's internal address over HTTPS only; send the host name in the TLS handshake too.
    proxy_ssl_server_name on;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # SignalR keeps its WebSocket open; the hub's keep-alive pings arrive well within this.
    proxy_read_timeout 1h;

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
    }

    location /api/hubs/ {
        # A proxy error logs the request line with its query string, and the hub's carries ?access_token=.
        error_log /var/log/nginx/error.log crit;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
    }

    location /api/exports {
        # A proxy error logs the request line with its query string, and the export URL's carries ?token= (#42).
        error_log /var/log/nginx/error.log crit;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
